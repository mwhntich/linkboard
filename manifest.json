{
  "manifest_version": 3,
  "name": "LinkBoard - Visual Bookmark Manager",
  "short_name": "LinkBoard",
  "version": "1.1.0",
  "description": "A drag-and-drop bookmark workspace that replaces your new tab page.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Save this page to LinkBoard (Ctrl+Shift+Y)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "contextMenus",
    "favicon",
    "tabs"
  ],
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Quick save the current page to Inbox"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkboard@mwhntich",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
